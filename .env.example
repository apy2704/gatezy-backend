PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gatezy
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis (for Bull queues & caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Twilio (WhatsApp & Voice Call Escalations)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_PHONE_FROM=

# Cloudflare R2 (Visitor Photo Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gatezy-visitor-photos
R2_PUBLIC_URL=

# Escalation & Cleanup Config
PHOTO_DELETE_DAYS=30
ESCALATION_STEP1_DELAY=30
ESCALATION_STEP2_DELAY=60
ESCALATION_STEP3_DELAY=90
JWT_SECRET=your_jwt_secret_key_here